{
  "name": "dsh-header-balance",
  "version": "0.1.1",
  "description": "会话页头部的余额芯片。点击跳转充值页，悬停看赠送与充值的拆分。每 60 秒与窗口获得焦点时刷新；未配置密钥、密钥失效、余额不足、限流、超时、断网、响应异常各自给出提示。密钥只在宿主侧读取。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./balance": {
      "default": "./lib/balance.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "scripts/inline-balance.mjs",
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:bundle": "node scripts/inline-balance.mjs",
    "check:bundle": "node scripts/inline-balance.mjs --check",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/balance.js && npm run check:bundle",
    "test": "node --test \"test/*.test.js\"",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "deepseek",
    "balance",
    "credit",
    "account"
  ],
  "author": "lijunyu726",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijunyu726/dsh-header-balance.git"
  },
  "homepage": "https://github.com/lijunyu726/dsh-header-balance#readme",
  "bugs": {
    "url": "https://github.com/lijunyu726/dsh-header-balance/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  }
}
